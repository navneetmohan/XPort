# ==============================================================================
# XPort Foundation Environment Configuration Template
# ==============================================================================

# Application Environment
ENVIRONMENT=development
SECRET_KEY=xport-insecure-development-secret-key-change-in-production
API_V1_STR=/api/v1
PROJECT_NAME="XPort Portfolio Optimization"

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=xport_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/xport_db

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# CORS Origins (comma-separated or JSON list)
BACKEND_CORS_ORIGINS=["http://localhost", "http://localhost:80", "http://localhost:3000", "http://localhost:5173"]

# Market Data Acquisition
MARKET_DATA_DEFAULT_SYMBOLS=RELIANCE.NS,TCS.NS,HDFCBANK.NS,INFY.NS,ICICIBANK.NS,NIFTYBEES.NS,GOLDBEES.NS
MARKET_DATA_DEFAULT_LOOKBACK_DAYS=1825
MARKET_DATA_SYNC_CRON=0 12 * * 1-5

# Frontend Configuration
VITE_API_BASE_URL=/api/v1
