# ==============================================================================
# XPort Foundation Environment Configuration Template
# ==============================================================================

# Application Environment
ENVIRONMENT=development
SECRET_KEY=xport-insecure-development-secret-key-change-in-production
API_V1_STR=/api/v1
PROJECT_NAME="XPort Portfolio Optimization"

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=xport_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/xport_db

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# CORS Origins (comma-separated or JSON list)
BACKEND_CORS_ORIGINS=["http://localhost", "http://localhost:80", "http://localhost:3000", "http://localhost:5173"]

# Market Data Acquisition
MARKET_DATA_DEFAULT_SYMBOLS=RELIANCE.NS,TCS.NS,HDFCBANK.NS,INFY.NS,ICICIBANK.NS,NIFTYBEES.NS,GOLDBEES.NS,SETF10GILT.NS,LIQUIDBEES.NS
MARKET_DATA_DEFAULT_LOOKBACK_DAYS=1825
MARKET_DATA_SYNC_CRON=0 12 * * 1-5
MARKET_DATA_REFRESH_INTERVAL=86400
MARKET_DATA_START_DATE=
YAHOO_FINANCE_TIMEOUT=30

# Feature Engineering Indicator Parameters
FEATURE_SMA_WINDOWS=20,50
FEATURE_EMA_WINDOWS=20,50
RSI_PERIOD=14
MACD_FAST_PERIOD=12
MACD_SLOW_PERIOD=26
MACD_SIGNAL_PERIOD=9

# Frontend Configuration
VITE_API_BASE_URL=/api/v1

