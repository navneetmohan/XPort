# Backend Local Environment Defaults
ENVIRONMENT=development
PROJECT_NAME="XPort Backend API"
API_V1_STR=/api/v1
SECRET_KEY=xport-insecure-development-secret-key-change-in-production

# PostgreSQL (Local / Docker)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/xport_db

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# CORS
BACKEND_CORS_ORIGINS=["http://localhost", "http://localhost:80", "http://localhost:3000", "http://localhost:5173"]

# Market Data Acquisition
MARKET_DATA_DEFAULT_SYMBOLS=RELIANCE.NS,TCS.NS,HDFCBANK.NS,INFY.NS,ICICIBANK.NS,NIFTYBEES.NS,GOLDBEES.NS,SETF10GILT.NS,LIQUIDBEES.NS
MARKET_DATA_DEFAULT_LOOKBACK_DAYS=1825
MARKET_DATA_SYNC_CRON=0 12 * * 1-5
MARKET_DATA_REFRESH_INTERVAL=86400
MARKET_DATA_START_DATE=
YAHOO_FINANCE_TIMEOUT=30

# Feature Engineering Indicator Parameters
FEATURE_SMA_WINDOWS=20,50
FEATURE_EMA_WINDOWS=20,50
RSI_PERIOD=14
MACD_FAST_PERIOD=12
MACD_SLOW_PERIOD=26
MACD_SIGNAL_PERIOD=9

